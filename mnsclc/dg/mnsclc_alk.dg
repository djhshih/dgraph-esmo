from dgraph.condition import has
from dgraph.graph import branch, node

late_line = node(
    'Lorlatinib [III, A; MCBS 4; ESCAT I-A]\nPlatinum-pemetrexed ChT [III, A]\nAtezolizumab-bevacizumab-paclitaxel-carboplatin [III, B; MCBS 3]'
)
systemic_progression_late = node(
    'Systemic progression',
    branch('no_lorlatinib', has('no_lorlatinib'), late_line),
)

alectinib = node(
    'Alectinib [I, A; MCBS 4; ESCAT I-A]\nBrigatinib [III, A; MCBS 4; ESCAT I-A]\nCeritinib [I, A; MCBS 4; ESCAT I-A]',
    systemic_progression_late,
)
lorlatinib = node(
    'Lorlatinib [III, A; MCBS 4; ESCAT I-A]',
    systemic_progression_late,
)

graph = node(
    'Stage IV mNSCLC with ALK translocation',
    node(
        'Alectinib [I, A; MCBS 4; ESCAT I-A]\nBrigatinib [I, A; MCBS 4; ESCAT I-A]\nLorlatinib [I, A; MCBS 4; ESCAT I-A]\nCrizotinib [I, B; MCBS 4; ESCAT I-A]\nCeritinib [I, B; MCBS 4; ESCAT I-A]',
        node(
            'Disease progression',
            branch(
                'Oligoprogression',
                has('Oligoprogression'),
                node(
                    'Local treatment (surgery or RT) and continue targeted systemic treatment [IV, C]',
                    node(
                        'Systemic progression',
                        node(
                            'Rebiopsy recommended (not mandatory for decision)',
                            branch(
                                'after_crizotinib',
                                has('after_crizotinib'),
                                alectinib
                            ),
                            branch(
                                'after_ALK_TKI_not_crizotinib',
                                has('after_ALK_TKI_not_crizotinib'),
                                lorlatinib
                            )
                        )
                    )
                )
            ),
            branch(
                'Systemic_progression',
                has('Systemic_progression'),
                node(
                    'Rebiopsy recommended (not mandatory for decision)',
                    branch(
                        'after_crizotinib',
                        has('after_crizotinib'),
                        alectinib
                    ),
                    branch(
                        'after_ALK_TKI_not_crizotinib',
                        has('after_ALK_TKI_not_crizotinib'),
                        lorlatinib
                    )
                )
            )
        )
    )
)
