digraph EOC_Recurrent {
    a [label="Recurrent EOC"];
    b [label="Assessment of the following factors [I-II, A]:\nHistotype\nBRCA1/BRCA2 status\nNumber of prior lines\nExposure and response to prior treatment\nTFIp\nPotential for surgery\nResidual toxicity\nPatient's general condition\nPatient preference"];
    c [label="Unfit_or_not_willing_to_receive_anticancer_therapy"];
    d [label="BSC"];
    e [label="Progression_during_platinum or Early_symptomatic_progression or Platinum_intolerance"];
    f [label="Early palliative care [I, A]\nSingle agent (non-platinum) [I, B] + bevacizumab, if not contraindicated or previously exposed [I, A; MCBS 4]\nTrabectedin-PLD (if TFIp > 6 months and platinum intolerant) [II, C; MCBS 2]"];
    g [label="Prior_response_to_platinum and No_contraindication_to_platinum"];
    h [label="First_relapse and Positive_AGO_score"];
    i [label="Not_first_relapse_or_negative_AGO_score"];
    j [label="Consider surgery by expert team [I, A]"];
    k [label="No_priority_for_symptomatic_response"];
    l [label="Priority_for_symptomatic_response and No_contraindication_to_bevacizumab"];
    m [label="Platinum-based doublet (PLD preferred) + PARPi maintenance, if responsive and PARPi-naive [I, A] (preferred option if BRCA1/BRCA2-mutated) or platinum-based doublet (PLD preferred) + bevacizumab [I, A] (if no contraindication or previous exposure to bevacizumab)"];
    n [label="Platinum-based doublet (PLD preferred) + bevacizumab [V, A]"];

    a -> b;
    b -> c;
    c -> d;
    b -> e;
    e -> f;
    b -> g;
    g -> h;
    g -> i;
    h -> j;
    j -> k;
    j -> l;
    i -> k;
    i -> l;
    k -> m;
    l -> n;
}
