digraph EOC_Early {
    a [label="Suspected early EOC (FIGO stage I-II)"];
    b [label="Surgical staging [III, A]"];
    c [label="LGSC_FIGO_stage_IA or Low-grade_EC_FIGO_stage_IA or Expansile_MC_FIGO_stage_IA-IB"];
    d [label="LGSC_FIGO_stage_IB-IC or CCC_FIGO_stage_IA-IC1 or Low-grade_EC_FIGO_stage_IB-IC or Expansile_MC_FIGO_stage_IC or Infiltrative_MC_FIGO_stage_IA"];
    e [label="HGSC_any_FIGO_stage or high-grade_EC_any_FIGO_stage or CCC_FIGO_stage_IC2-IC3 or Infiltrative_MC_FIGO_stage_IB-IC3 or Any_histotype_FIGO_stage_II"];
    f [label="Observation"];
    g [label="Adjuvant ChT optional [III, C]: paclitaxel-carboplatin [I, B] (minimum 3 cycles or 6 cycles if FIGO stage IC [II, B]) or carboplatin alone (6 cycles) [I, A]"];
    h [label="Adjuvant ChT [II, A]: paclitaxel-carboplatin [I, B] (6 cycles; 3 cycles are acceptable unless HGSC/high-grade EC or FIGO stage IC-II [II, B]) or carboplatin alone (6 cycles) [I, A]"];

    a -> b;
    b -> c;
    b -> d;
    b -> e;
    c -> f;
    d -> g;
    e -> h;
}
