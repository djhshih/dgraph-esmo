digraph treatment {
    a [label="Positive Pap-smear / HPV-high risk positive / suspected cervix"];
    b [label="Colposcopy / Biopsy"];
    c [label="CIN2 or CIN3"];
    d [label="Conisation"];
    e [label="Invasive_cervical_cancer"];
    f [label="Early_disease"];
    g [label="FIGO_IA1"];
    h [label="No_LVSI"];
    v [label="Simple hysterectomy\nFrozen section: conisation only if negative margins"];
    w [label="With_LVSI"];
    x [label="Simple hysterectomy + PLND +/- PALND\nTrachelectomy"];
    i [label="FIGO_IA2"];
    j [label="Radical hysterectomy\nSimple hysterectomy\nTrachelectomy + PLND +/- PALND\nSLN"];
    k [label="Adjuvant treatment depending on risk factors"];
    l [label="FIGO_IB1 or FIGO_IIA1"];
    m [label="Radical hysterectomy + PLND +/- PALND\nSLN\nFrozen section: trachelectomy\nCRT"];
    n [label="Locally_advanced_disease"];
    o [label="FIGO_IB2 or FIGO_IIB or FIGO_IIIB"];
    p [label="CRT\nTailoring of radiation according to surgical staging or PET-CT\n\nNeoadjuvant chemotherapy followed by surgery or RT"];
    q [label="FIGO_IVA"];
    r [label="Chemotherapy\n(C)RT\nPelvic exenteration"];
    s [label="Metastatic_disease"];
    t [label="FIGO_IVB"];
    u [label="Chemotherapy + bevacizumab\nRT"];

    a -> b;
    b -> c;
    c -> d;
    b -> e;
    e -> f;
    f -> g;
    g -> h;
    h -> v;
    g -> w;
    w -> x;
    f -> i;
    i -> j;
    j -> k;
    f -> l;
    l -> m;
    m -> k;
    b -> n;
    n -> o;
    o -> p;
    n -> q;
    q -> r;
    b -> s;
    s -> t;
    t -> u;
}
