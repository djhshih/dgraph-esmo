from dgraph.condition import all_of, any_of, has
from dgraph.graph import branch, chain, node

graph = node(
    'Oropharyngeal cancer p16-negative or p16-positive',
    branch(
        '(cT1 or cT2) and (cN0 or cN1) and cM0',
        all_of(all_of(any_of(has('cT1'), has('cT2')), any_of(has('cN0'), has('cN1'))), has('cM0')),
        node('Standard:\nRT (T and N) [IV, A]\nTransoral surgery (T and N) followed by RT or CRT if indicated [IV, A]')
    ),
    branch(
        '((cT3 or cT4) and cN0 and cM0) or ((cT1 or cT2 or cT3 or cT4) and (cN1 or cN2 or cN3) and cM0)',
        any_of(all_of(all_of(any_of(has('cT3'), has('cT4')), has('cN0')), has('cM0')), all_of(all_of(any_of(any_of(any_of(has('cT1'), has('cT2')), has('cT3')), has('cT4')), any_of(any_of(has('cN1'), has('cN2')), has('cN3'))), has('cM0'))),
        node('Standard:\nConcomitant CRT (T and N) [IV, A]\n\nOption:\nSurgery (T and N) followed by RT or CRT if indicated [IV, B]')
    )
)
