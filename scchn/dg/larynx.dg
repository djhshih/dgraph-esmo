from dgraph.condition import all_of, any_of, has
from dgraph.graph import branch, chain, node

graph = node(
    'Larynx cancer',
    branch(
        '(cT1 or cT2 or cT3) and (cN0 or cN1 or cN2 or cN3) and cM0',
        all_of(all_of(any_of(any_of(has('cT1'), has('cT2')), has('cT3')), any_of(any_of(any_of(has('cN0'), has('cN1')), has('cN2')), has('cN3'))), has('cM0')),
        node('Standard:\nConservative (laser) surgery (T and N) followed by RT or CRT if indicated [IV, A]\nRT (T1-2, N0) (T and N) or CRT (T3 or N1-3) (T and N) [IV, A]')
    ),
    branch(
        '((cT1 or cT2) and (cN2 or cN3) and cM0) or (cT3b and (cN0 or cN1 or cN2 or cN3) and cM0)',
        any_of(all_of(all_of(any_of(has('cT1'), has('cT2')), any_of(has('cN2'), has('cN3'))), has('cM0')), all_of(all_of(has('cT3b'), any_of(any_of(any_of(has('cN0'), has('cN1')), has('cN2')), has('cN3'))), has('cM0'))),
        node('Standard:\nConcomitant CRT (T and N) [I, A]\nIf total laryngectomy is necessary, concomitant CRT (T and N) or induction ChT followed by (i) RT (T and N) in case of complete or partial response after induction or (ii) surgery in case of stable or progressive disease after induction [I, A]\n\nOption:\nSurgery (T and N) and lymph node dissection followed by RT or CRT if indicated [IV, B]')
    ),
    branch(
        'cT4a and (cN0 or cN1 or cN2 or cN3) and cM0',
        all_of(all_of(has('cT4a'), any_of(any_of(any_of(has('cN0'), has('cN1')), has('cN2')), has('cN3'))), has('cM0')),
        node('Standard:\nSurgery (T and N) followed by RT or CRT [IV, A]\n\nOption:\nConcomitant CRT (T and N) [IV, B]')
    ),
    branch(
        'cT4b and (cN0 or cN1 or cN2 or cN3) and cM0',
        all_of(all_of(has('cT4b'), any_of(any_of(any_of(has('cN0'), has('cN1')), has('cN2')), has('cN3'))), has('cM0')),
        node('Options:\nInduction ChT followed by RT (T and N) [IV, B]\nConcomitant CRT (T and N) [IV, B]\nPalliative treatment: systemic ChT/immunotherapy and/or palliative RT and/or BSC [IV, B]')
    )
)
