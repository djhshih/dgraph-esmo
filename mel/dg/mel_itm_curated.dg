from pathlib import Path

from dgraph.condition import all_of, any_of, has, lt
from dgraph.dg_loader import load_dg
from dgraph.graph import branch, node

# See Figure 4 for systemic therapy options
_dir = Path(__file__).parent
fig4 = load_dg(_dir / 'mel_adv_st3_or_st4_curated.dg')

graph = node(
    'Patients with ITMs',
    branch(
        'Resectable_disease',
        has('Resectable_disease'),
        node('Clinical trial [V, A]\nComplete excision with clear margins [IV, B] followed by adjuvant therapy [I, A]\nConsider neoadjuvant nivolumab-ipilimumab [I, A; MCBS A] followed by adjuvant therapy based on pathological response and BRAF status, or neoadjuvant plus adjuvant pembrolizumab [II, A]')
    ),
    branch(
        'Unresectable_disease or (Resectable_disease and < 6 DFI_months)',
        # any_of(has('Unresectable_disease'), all_of(all_of(has('Resectable_disease'), has('<6')), has('DFI_months'))),
        # manual_fix
        any_of(
            has('Unresectable_disease'),
            all_of(has('Resectable_disease'), lt('DFI_months', 6)),
        ),
        node(
            'Clinical trial [V, A]\nConsider local therapy options:\nT-VEC intralesional therapy [I, B; MCBS 3]\nRT [IV, C]\nECT [IV, C]\nLimited palliative excision [IV, C]\nILI or ILP with melphalan (only high-volume centres) [IV, C]',
            fig4,
        )
    )
)
