from dgraph.condition import has
from dgraph.graph import branch, chain, node

graph = node(
    'Follow-up of patients with melanoma',
    node(
        'Self-examination and risk assessment:\nPatients should be advised to avoid sunburn or unprotected solar exposure or any artificial UV exposure; lifelong regular self-examinations of the skin and peripheral LNs is also recommended [III, A]\nPatients must be made aware that family members have an increased melanoma risk [III, B]',
        node(
            'Follow-up:\nFollow-up should comprise an MDT [V, A]\nPatients should be clinically monitored with whole body examinations, preferentially by a dermatologist, to detect relapse and to recognise additional skin tumours, especially secondary melanomas, as early as possible [III, B]\nThere is no consensus on the optimal follow-up schedule or the utility of imaging and blood tests for patients with resected melanoma; respective national guidelines should be consulted, with adjustment as required, considering available resources, particularly after 3 years of follow-up [IV, B]',
            node(
                'Suggested follow-up schedule by disease stage',
                branch(
                    'Stage_IA',
                    has('Stage_IA'),
                    node('Clinical-dermatological examination: Q6 mo (yr 1-3), Q12 mo (yr 4-10), Q12 mo (yr >10)\nLN US: NA\nLaboratory examination: NA\nCT (or PET-CT) of neck, thorax, abdomen, pelvis; brain MRI: NA [V, B]')
                ),
                branch(
                    'Stage_IB-IIA',
                    has('Stage_IB-IIA'),
                    node('Clinical-dermatological examination: Q3-6 mo (yr 1-3), Q6 mo (yr 4-10), Q12 mo (yr >10)\nLN US: Q6 mo (yr 1-3)\nLaboratory examination: Q3-6 mo (yr 1-3)\nCT (or PET-CT) of neck, thorax, abdomen, pelvis; brain MRI: NA [V, B]')
                ),
                branch(
                    'Stage_IIB-IIIC',
                    has('Stage_IIB-IIIC'),
                    node('Clinical-dermatological examination: Q3 mo (yr 1-3), Q6 mo (yr 4-10), Q12 mo (yr >10)\nLN US: Q3-6 mo (yr 1-3)\nLaboratory examination: Q3-6 mo (yr 1-3)\nCT (or PET-CT) of neck, thorax, abdomen, pelvis: Q3-6 mo (yr 1-3)\nBrain MRI: Q6 mo (yr 1-3) [V, B]')
                ),
                branch(
                    'Stage_IIID',
                    has('Stage_IIID'),
                    node('Clinical-dermatological examination: Q3 mo (yr 1-3), Q6 mo (yr 4-10), Q12 mo (yr >10)\nLN US: Q3-6 mo (yr 1-3)\nLaboratory examination: Q3-6 mo (yr 1-3)\nCT (or PET-CT) of neck, thorax, abdomen, pelvis: Q3-6 mo (yr 1-3)\nBrain MRI: Q3-6 mo (yr 1-3) [V, B]')
                ),
                branch(
                    'Stage_IV_NED_resected_CR',
                    has('Stage_IV_NED_resected_CR'),
                    node('Clinical-dermatological examination: Q3 mo (yr 1-3), Q6 mo (yr 4-10), Q12 mo (yr >10)\nLN US: Q3-6 mo (yr 1-3)\nLaboratory examination: Q3-6 mo (yr 1-3)\nCT (or PET-CT) of neck, thorax, abdomen, pelvis: Q3-6 mo (yr 1-3)\nBrain MRI: Q3 mo (yr 1-3) [V, B]')
                ),
                branch(
                    'Stage_IV_M1a-M1d_distant_metastases',
                    has('Stage_IV_M1a-M1d_distant_metastases'),
                    node('Individualised to each patient, depending on therapy and symptoms; otherwise, staging Q12 weeks\nFor patients achieving CR, staging Q12 weeks (yr 1-3) after ICI discontinuation [V, B]')
                )
            )
        )
    )
)
