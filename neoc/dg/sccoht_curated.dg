from dgraph.condition import always, any_of, has
from dgraph.graph import branch, chain, node

hdct = node(
    'HDCT + ASCT in selected cases [II, C]',
    branch(
        'Pelvic_RT',
        # has('Pelvic_RT'),
        # manual_fix: subsequent pelvic RT after HDCT is a treatment option
        always(),
        chain('Pelvic RT [IV, C]', 'RELAPSE:\nCyclophosphamide/doxorubicin/vincristine [V, B]\nTopotecan [V, C]\nPhase I trial')
    ),
    node('RELAPSE:\nCyclophosphamide/doxorubicin/vincristine [V, B]\nTopotecan [V, C]\nPhase I trial')
)
pelvic = chain('Pelvic RT [IV, C]', 'RELAPSE:\nCyclophosphamide/doxorubicin/vincristine [V, B]\nTopotecan [V, C]\nPhase I trial')

graph = node(
    'SCCOHT',
    branch(
        'Stage_I-II',
        has('Stage_I-II'),
        node(
            'TAH/BSO/Staging [IV, A]',
            node(
                'Adjuvant ChT [III, B]\nCisplatin-etoposide-based',
                branch(
                    'HDCT_ASCT',
                    # has('HDCT_ASCT'),
                    # manual_fix: HDCT + ASCT is a treatment option, not a patient tag
                    always(),
                    hdct
                ),
                branch(
                    'Pelvic_RT',
                    # has('Pelvic_RT'),
                    # manual_fix: pelvic RT is a treatment option, not a patient tag
                    always(),
                    pelvic
                )
            )
        )
    ),
    branch(
        'Stage_III-IV',
        has('Stage_III-IV'),
        node(
            'TAH/BSO/Staging [IV, A]',
            branch(
                'Debulking_feasible',
                has('Debulking_feasible'),
                node(
                    'Debulking [IV, A]',
                    node(
                        'Adjuvant ChT [III, B]\nCisplatin-etoposide-based',
                        node(
                            'Complete response / resection',
                            branch(
                                'Complete_response or Resection',
                                any_of(has('Complete_response'), has('Resection')),
                                hdct
                            ),
                            branch(
                                'Not_complete_response_or_resection',
                                has('Not_complete_response_or_resection'),
                                branch(
                                    'Pelvic_RT',
                                    # has('Pelvic_RT'),
                                    # manual_fix: pelvic RT is a treatment option, not a patient tag
                                    always(),
                                    pelvic
                                ),
                                branch(
                                    'HDCT_ASCT',
                                    # has('HDCT_ASCT'),
                                    # manual_fix: dashed HDCT arm when no CR/resection
                                    always(),
                                    hdct
                                )
                            )
                        )
                    )
                )
            ),
            branch(
                'Debulking_not_feasible',
                has('Debulking_not_feasible'),
                node(
                    'Neoadjuvant ChT [IV, C]\nCisplatin-etoposide-based',
                    node(
                        'Debulking [IV, A]',
                        node(
                            'Complete response / resection',
                            branch(
                                'Complete_response or Resection',
                                any_of(has('Complete_response'), has('Resection')),
                                hdct
                            ),
                            branch(
                                'Not_complete_response_or_resection',
                                has('Not_complete_response_or_resection'),
                                branch(
                                    'Pelvic_RT',
                                    # has('Pelvic_RT'),
                                    # manual_fix: pelvic RT is a treatment option, not a patient tag
                                    always(),
                                    pelvic
                                ),
                                branch(
                                    'HDCT_ASCT',
                                    # has('HDCT_ASCT'),
                                    # manual_fix: dashed HDCT arm when no CR/resection
                                    always(),
                                    hdct
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)
