digraph G {
    a [label="Stage IV SqCC without contraindication for immunotherapy"];
    b [label="Never_smoked or light_smoker or smoked_under_15_packyears or long_time_ex_smoker"];
    c [label="Oligometastatic"];
    d [label="ECOG_PS_and_PD-L1_expression_level"];
    e [label="Molecular test (EGFR/ALK/ROS1/BRAF/RET/MET/EGFR ex20ins/KRAS G12C/NTRK/HER2)"];
    f [label="Molecular_test_positive"];
    g [label="Molecular_test_negative"];
    h [label="Targeted therapy"];
    i [label="Follow recommended treatment in line of ECOG PS and PD-L1 expression level"];
    j [label="Systemic therapy & LRT [II, B]"];
    k [label=">= 0 PS and <= 2 PS and >= 50 pdl1_percent"];
    l [label=">= 0 PS and <= 1 PS and any_expression_of_PD-L1"];
    m [label="= 2 PS and < 50 pdl1_percent"];
    n [label=">= 3 PS and <= 4 PS"];
    o [label="Pembrolizumab [I, A; MCBS 5]\nAtezolizumab (also for ICs >=10%) [I, A; MCBS 5]\nCemiplimab [I, A; MCBS 4] (for PS 2 for all drugs: [III, B])"];
    p [label="Pembrolizumab-carboplatin-(nab)-paclitaxel (4 cycles) followed by pembrolizumab [I, A; MCBS 4]\nNivolumab-ipilimumab + 2 cycles of platinum-doublet ChT followed by nivolumab-ipilimumab [I, A; MCBS 4]\nCemiplimab-platinum-doublet ChT (4 cycles) followed by cemiplimab [I, A]\nDurvalumab-tremelimumab-platinum-doublet ChT (4 cycles) followed by durvalumab-tremelimumab (tremelimumab one additional dose) [I, A; MCBS 4]\nNivolumab-ipilimumab (only for PD-L1 >=1%) [I, A; MCBS 4]"];
    q [label="Platinum-doublet (carboplatin preferred) ChT [I, A]\nSingle-agent ChT (gemcitabine, vinorelbine, docetaxel) [I, B]"];
    r [label="Disease progression"];
    s [label="Disease progression"];
    t [label="Disease progression"];
    u [label=">= 0 PS and <= 2 PS"];
    v [label=">= 3 PS and <= 4 PS"];
    w [label=">= 0 PS and <= 2 PS"];
    x [label=">= 3 PS and <= 4 PS"];
    y [label=">= 0 PS and <= 2 PS"];
    z [label=">= 3 PS and <= 4 PS"];
    aa [label="Platinum-doublet ChT (combined with gemcitabine, vinorelbine or taxane) [I, A]\nIf 4 cycles of gemcitabine-cisplatin, gemcitabine maintenance [I, C]\nRe-challenge ICI [III, B]"];
    ab [label="Docetaxel [I, B]\nRamucirumab-docetaxel [I, B; MCBS 1]\nAfatinib [I, C; MCBS 2]\nRe-challenge ICI [III, B]"];
    ac [label="Nivolumab [I, A; MCBS 5]\nAtezolizumab [I, A; MCBS 5]\nPembrolizumab (PD-L1 >=1%) [I, A; MCBS 5]\nDocetaxel [I, B]\nRamucirumab-docetaxel [I, B; MCBS 1]\nAfatinib [I, C; MCBS 2]"];
    ad [label="Best Supportive Care alone [III, A]"];

    a -> b;
    a -> c;
    a -> d;
    b -> e;
    e -> f;
    e -> g;
    f -> h;
    g -> i;
    c -> j;
    d -> k;
    d -> l;
    d -> m;
    d -> n;
    k -> o;
    l -> p;
    m -> q;
    o -> r;
    p -> s;
    q -> t;
    r -> u;
    r -> v;
    u -> aa;
    v -> ad;
    s -> w;
    s -> x;
    w -> ab;
    x -> ad;
    t -> y;
    t -> z;
    y -> ac;
    z -> ad;
    n -> ad;
}
