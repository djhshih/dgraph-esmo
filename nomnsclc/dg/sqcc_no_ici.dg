from dgraph.condition import all_of, any_of, has
from dgraph.graph import branch, chain, node

best = node('Best Supportive Care alone [III, A]')
docetaxel = node('Docetaxel [I, B]\nRamucirumab-docetaxel [I, B; MCBS 1]\nAfatinib [I, C; MCBS 2]')

graph = node(
    'Stage IV SqCC with contraindication for immunotherapy',
    branch(
        'Never_smoked or light_smoker or smoked_under_15_packyears or long_time_ex_smoker or age_under_50',
        any_of(any_of(any_of(any_of(has('Never_smoked'), has('light_smoker')), has('smoked_under_15_packyears')), has('long_time_ex_smoker')), has('age_under_50')),
        node(
            'Molecular test (EGFR/ALK/ROS1/BRAF/RET/MET/EGFR ex20ins/KRAS G12C/NTRK/HER2)',
            branch(
                'Molecular_test_positive',
                has('Molecular_test_positive'),
                node('Targeted therapy')
            ),
            branch(
                'Molecular_test_negative',
                has('Molecular_test_negative'),
                node('Follow recommended treatment in line with ECOG PS')
            )
        )
    ),
    branch(
        'Oligometastatic',
        has('Oligometastatic'),
        node('Systemic therapy & LRT [II, B]')
    ),
    branch(
        'ECOG_PS',
        has('ECOG_PS'),
        branch(
            '>= 0 PS and <= 1 PS',
            all_of(all_of(all_of(has('>=0'), has('PS')), has('<=1')), has('PS')),
            node(
                'Platinum-doublet ChT (combined with gemcitabine, vinorelbine or taxane) [I, A]\nIf 4 cycles of gemcitabine-cisplatin: gemcitabine maintenance [I, C]',
                node(
                    'Disease progression',
                    branch(
                        '>= 0 PS and <= 2 PS',
                        all_of(all_of(all_of(has('>=0'), has('PS')), has('<=2')), has('PS')),
                        docetaxel
                    ),
                    branch(
                        '>= 3 PS and <= 4 PS',
                        all_of(all_of(all_of(has('>=3'), has('PS')), has('<=4')), has('PS')),
                        best
                    )
                )
            )
        ),
        branch(
            '= 2 PS',
            all_of(all_of(has('='), has('2')), has('PS')),
            node(
                'Platinum-doublet ChT (combined with gemcitabine, vinorelbine or taxane) [I, A]\nSingle-agent ChT (gemcitabine, vinorelbine, docetaxel) [I, B]',
                node(
                    'Disease progression',
                    branch(
                        '>= 0 PS and <= 2 PS',
                        all_of(all_of(all_of(has('>=0'), has('PS')), has('<=2')), has('PS')),
                        docetaxel
                    ),
                    branch(
                        '>= 3 PS and <= 4 PS',
                        all_of(all_of(all_of(has('>=3'), has('PS')), has('<=4')), has('PS')),
                        best
                    )
                )
            )
        ),
        branch(
            '>= 3 PS and <= 4 PS',
            all_of(all_of(all_of(has('>=3'), has('PS')), has('<=4')), has('PS')),
            best
        )
    )
)
