from dgraph.condition import all_of, any_of, ge, has, lt
from dgraph.graph import branch, chain, node

no = chain('No_progression', 'Osimertinib [I, A; MCBS 4]', 'Surveillance [I, A]')
surveillance = node('Surveillance [I, A]')

graph = node(
    'Unresectable stage III NSCLC',
    node(
        'EGFR and PD-L1 testing\nMDT discussion',
        branch(
            'EGFR_mutation or < 1 pdl1_percent',
            # any_of(has('EGFR_mutation'), all_of(has('<1'), has('pdl1_percent'))),
            # manual_fix
            any_of(has('EGFR_mutation'), lt('pdl1_percent', 1)),
            branch(
                'Concurrent_CRT_eligible',
                has('Concurrent_CRT_eligible'),
                node(
                    'Concurrent CRT [I, A]',
                    branch(
                        'EGFR_exon_19_deletion or L858R',
                        any_of(has('EGFR_exon_19_deletion'), has('L858R')),
                        no
                    ),
                    branch(
                        'no_EGFR_exon_19_deletion and no_L858R',
                        all_of(has('no_EGFR_exon_19_deletion'), has('no_L858R')),
                        surveillance
                    )
                )
            ),
            branch(
                'Concurrent_CRT_ineligible',
                has('Concurrent_CRT_ineligible'),
                branch(
                    'Sequential_CRT',
                    has('Sequential_CRT'),
                    branch(
                        'EGFR_exon_19_deletion or L858R',
                        any_of(has('EGFR_exon_19_deletion'), has('L858R')),
                        no
                    ),
                    branch(
                        'no_EGFR_exon_19_deletion and no_L858R',
                        all_of(has('no_EGFR_exon_19_deletion'), has('no_L858R')),
                        surveillance
                    )
                ),
                branch(
                    'RT',
                    has('RT'),
                    surveillance
                )
            )
        ),
        branch(
            'EGFR_WT and > 1 pdl1_percent',
            # all_of(all_of(has('EGFR_WT'), has('>1')), has('pdl1_percent')),
            # manual_fix
            all_of(has('EGFR_WT'), ge('pdl1_percent', 1)),
            branch(
                'Concurrent_CRT_eligible',
                has('Concurrent_CRT_eligible'),
                chain('Concurrent CRT [I, A]', 'No_progression', 'Durvalumab for 1 year [I, A; MCBS 4]', 'Surveillance [I, A]')
            ),
            branch(
                'Concurrent_CRT_ineligible',
                has('Concurrent_CRT_ineligible'),
                branch(
                    'Sequential_CRT',
                    has('Sequential_CRT'),
                    chain('No_progression', 'Durvalumab for 1 year [III, B]', 'Surveillance [I, A]')
                ),
                branch(
                    'RT',
                    has('RT'),
                    surveillance
                )
            )
        )
    )
)
